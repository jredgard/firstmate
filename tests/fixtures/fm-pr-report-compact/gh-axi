#!/usr/bin/env bash
# Comment-only API transport fixture, also usable from merge tests.
set -euo pipefail
if [ -z "${AZ_DESCRIPTION_FILE:-}" ]; then
  encoded=$(printf '{"body":"", "head":""}' | base64 | tr -d '\n')
  printf 'api_response:\n  body: %s\n  truncated: false\n' "$encoded"
  exit 0
fi
printf '%s\n' "$*" >> "$AZ_TRACE"
case " $* " in
  *' POST '*)
    [ "${AZ_POST_REFUSED:-false}" != true ] || exit 3
    cat > "$AZ_POST_BODY"
    [ "${AZ_PERSIST_POST:-true}" != false ] || exit 0
    python3 - "$AZ_POST_BODY" "$AZ_THREADS_FILE" <<'PY'
import json, sys
body = json.load(open(sys.argv[1]))["body"]
json.dump({"value": [{"comments": [{"content": body}]}]}, open(sys.argv[2], "w"))
PY
    exit 0
    ;;
  *'/comments '*)
    python3 - "$AZ_THREADS_FILE" "${AZ_RACE_THREADS:-}" "${AZ_RACE_READ:-0}" <<'PY'
import json, os, sys
path, race, target = sys.argv[1:]
counter = path + ".reads"
n = int(open(counter).read()) + 1 if os.path.exists(counter) else 1
open(counter, "w").write(str(n))
if race and n >= int(target):
    open(path, "w").write(open(race).read())
threads = json.load(open(path))["value"]
print(json.dumps([c["content"] for t in threads for c in t["comments"]]))
PY
    ;;
  *)
    python3 - "$AZ_DESCRIPTION_FILE" "${AZ_PR_HEAD:-}" <<'PY'
import json, sys
print(json.dumps({"body": open(sys.argv[1]).read(), "head": sys.argv[2]}))
PY
    ;;
esac | base64 | tr -d '\n' > "$AZ_TRACE.encoded"
printf 'api_response:\n  body: %s\n  truncated: false\n' "$(cat "$AZ_TRACE.encoded")"
