#!/usr/bin/env python3
"""Normalize a no-mistakes PR description after ADO checks pass.

Azure DevOps hard-truncates PR descriptions at 4000 characters. A no-mistakes
run whose review carried substantive findings embeds their full texts in the
report's <details> blocks, which can push the assembled body past the cap and
chop it mid-sentence (observed on Mosaiq PR 54362, 2026-09-02: 4023 chars, tail
cut inside a finding). ADO refuses description edits once a PR completes, so
the only window to fix the archive is between checks-passed and merge.

This tool keeps the attestation comment byte-for-byte (the RequireNoMistakes
gate binds on it), removes any stale visible status board or <details> report,
and emits one verified passed line per attested step. It verifies that the PR
exists and that its ADO Build policy is approved before writing passed for the
PR and CI steps. If the normalized body is too long, it trims Intent and then
What Changed prose while preserving work-item tokens, the Risk section, and
the complete attestation. A fenced raw changed-file dump is replaced with a
Files-tab pointer so a truncated, unclosed fence cannot swallow later sections.
On EVERY gated PR — whether or not the description fits — a closed review
comment narrates the run: each round lists its findings by id, severity, and a
bounded one-line summary. A finding is labeled fixed,
citing the fixing round's fix summary, only when it has a usable id that stays
absent from every later round, so the label never contradicts the residual
verdict; a fix summary not attributed that way stays on its own round line
("fix", or "fix attempted" when the prior round's findings persisted), so
failed-fix history is never dropped. Any residual findings follow in full
(read-only lookup in ~/.no-mistakes/state.sqlite by the
PR's /pullrequest/<id> url suffix), so reviewers always find them in the same
place: comments allow ~150k characters and survive merge. A rerun is a no-op
once the thread exists.

Usage:
  fm-pr-report-compact <org-url> <pr-id>            # normalize in place via az
  fm-pr-report-compact --stdin < body > normalized  # pure CI-green test filter

Always posts the review comment (skipping only when no local run data or an
existing thread is found). Only active PRs are rewritten: on a completed or
abandoned PR the comment still posts and the description is left as-merged.
Run it only after the pipeline reports checks-passed (custody has returned);
never during a run. The --stdin interface performs no network calls and treats
PR and CI as verified so description shapes can be tested in isolation.
"""
import json
import os
import re
import sqlite3
import subprocess
import sys
import tempfile

CAP = 4000
COMMENT_HEADING = "## no-mistakes review — recorded findings (full texts)"
FINDING_SUMMARY_LIMIT = 240
TRUNCATION_RE = re.compile(r"(?:…|\.\.\.)?\(description truncated\)", re.IGNORECASE)
ATTESTATION_RE = re.compile(
    r"<!--\s*no-mistakes-pipeline-attestation:v1\s+(\{.*?\})\s*-->",
    re.DOTALL,
)
WORK_ITEM_RE = re.compile(
    r"(?i)(?:\bAB#\d+\b|"
    r"https?://[^\s<>()]*/_workitems/edit/\d+[^\s<>()]*|"
    r"\bwork[- ]item(?:\s+|\s*[:#]\s*)#?\d+\b)"
)
BUILD_POLICY_TYPE_ID = "0609b952-1397-4640-95ec-e00a01b2c241"


def first_sentence(value: str) -> str:
    """Return the first prose sentence, collapsing internal whitespace."""
    text = " ".join(value.split())
    match = re.match(r".*?[.!?](?=\s|$)", text)
    return (match.group(0) if match else text).strip()


def section_body(src: str, heading: str) -> "str | None":
    """Return a level-two Markdown section body, case-insensitively."""
    match = re.search(
        rf"(?ims)^##[ \t]+{re.escape(heading)}[ \t]*\r?\n(.*?)(?=^##[ \t]+|\Z)",
        src,
    )
    return match.group(1).strip() if match else None


def replace_section_body(src: str, heading: str, body: str) -> str:
    """Replace one level-two Markdown section body."""
    pattern = re.compile(
        rf"(?ims)(^##[ \t]+{re.escape(heading)}[ \t]*\r?\n).*?(?=^##[ \t]+|\Z)"
    )
    return pattern.sub(
        lambda match: match.group(1) + "\n" + body.strip() + "\n\n",
        src,
        count=1,
    )


def compact_intent(src: str) -> str:
    """Reduce Intent to its first sentence while retaining work-item tokens."""
    original = section_body(src, "Intent")
    if original is None:
        return src
    summary = first_sentence(original)
    tokens = list(dict.fromkeys(WORK_ITEM_RE.findall(original)))
    missing = [token for token in tokens if token.casefold() not in summary.casefold()]
    if missing:
        summary = f"{summary} Work items: {', '.join(missing)}."
    return replace_section_body(src, "Intent", summary)


def compact_what_changed(src: str, maximal: bool = False) -> str:
    """Condense What Changed bullets, or replace them with a minimal pointer."""
    original = section_body(src, "What Changed")
    if original is None:
        return src
    if maximal:
        summary = "- See the commit diff for implementation details."
    else:
        items = []
        for line in original.splitlines():
            line = line.strip()
            if not line:
                continue
            line = re.sub(r"^[-*+]\s+", "", line)
            sentence = first_sentence(line)
            if sentence:
                items.append(f"- {sentence}")
        summary = "\n".join(items) or "- See the commit diff for implementation details."
    return replace_section_body(src, "What Changed", summary)


def remove_changed_file_dump(src: str) -> str:
    """Replace no-mistakes' fenced raw file dump with a short stable pointer."""
    original = section_body(src, "What Changed")
    if original is None:
        return src
    dump = re.compile(
        r"(?ims)^[ \t]*```text[ \t]*\r?\n.*?(?:^[ \t]*```[ \t]*(?:\r?\n|\Z)|\Z)"
    )
    if not dump.search(original):
        return src
    replacement = dump.sub("Full file list: see the Files tab.\n", original)
    return replace_section_body(src, "What Changed", replacement)


def code_fences_balanced(src: str) -> bool:
    """Return whether Markdown backtick and tilde code fences are balanced."""
    opened = None
    for match in re.finditer(r"(?m)^[ \t]{0,3}(`{3,}|~{3,})(.*)$", src):
        marker = match.group(1)
        if opened is None:
            opened = marker
        elif (
            marker[0] == opened[0]
            and len(marker) >= len(opened)
            and not match.group(2).strip()
        ):
            opened = None
    return opened is None


def remove_status_board(src: str, step_names: list) -> str:
    """Remove old visible status lines for attested steps from the head."""
    names = "|".join(re.escape(name) for name in step_names)
    if not names:
        return src
    status_line = re.compile(
        rf"^[ \t]*-[ \t]+\S+[ \t]+(?:\*\*)?(?:{names})(?:\*\*)?"
        r"[ \t]+-.*$",
        re.IGNORECASE,
    )
    return "".join(
        line for line in src.splitlines(keepends=True)
        if not status_line.match(line.rstrip("\r\n"))
    )


def normalized_body(head: str, attestation: str, steps: list) -> str:
    """Assemble the canonical head, attestation, and passed status board."""
    if not re.search(r"(?mi)^##[ \t]+Pipeline[ \t]*$", head):
        head = head.rstrip() + "\n\n## Pipeline"
    lines = [f"- ✅ {step['step']} - passed" for step in steps]
    return head.rstrip() + "\n\n" + attestation + "\n\n" + "\n".join(lines)


def compact(src: str, verified_steps: "set[str] | None" = None) -> "str | None":
    """Return the normalized body, or None when src is already normalized."""
    match = ATTESTATION_RE.search(src)
    if not match:
        raise SystemExit("error: no valid no-mistakes attestation found")
    try:
        payload = json.loads(match.group(1))
        steps = payload["steps"]
        step_names = [str(step["step"]) for step in steps]
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        raise SystemExit(f"error: invalid no-mistakes attestation: {exc}") from exc
    if not isinstance(steps, list) or not steps:
        raise SystemExit("error: no steps found in no-mistakes attestation")

    verified = {name.casefold() for name in (verified_steps or step_names)}
    for step in steps:
        name = str(step["step"])
        status = str(step.get("status") or "").casefold()
        if name.casefold() in ("pr", "ci"):
            if name.casefold() not in verified:
                raise SystemExit(
                    f"error: {name} was not verified green; description not updated"
                )
        elif status not in ("completed", "passed"):
            raise SystemExit(
                f"error: attested step {name} is {status or 'unknown'}, not passed; "
                "description not updated"
            )

    attestation = match.group(0)
    head = remove_status_board(src[:match.start()], step_names).rstrip()
    head = TRUNCATION_RE.sub("", head)
    head = remove_changed_file_dump(head).rstrip()
    body = normalized_body(head, attestation, steps)
    if len(body) > CAP:
        head = compact_intent(head).rstrip()
        body = normalized_body(head, attestation, steps)
    if len(body) > CAP:
        head = compact_what_changed(head).rstrip()
        body = normalized_body(head, attestation, steps)
    if len(body) > CAP:
        head = compact_what_changed(head, maximal=True).rstrip()
        body = normalized_body(head, attestation, steps)
    if len(body) > CAP:
        raise SystemExit(
            f"error: normalized description is still {len(body)} chars after maximal "
            f"legal trimming (Azure DevOps cap is {CAP}); description not updated"
        )
    if TRUNCATION_RE.search(body):
        raise SystemExit(
            "error: normalized description still contains a truncation marker; "
            "description not updated"
        )
    if not code_fences_balanced(body):
        raise SystemExit(
            "error: normalized description contains an unclosed code fence; "
            "description not updated"
        )
    return None if src == body else body


def parse_findings(raw: str, source: str) -> list:
    """Return the findings list from one recorded review payload."""
    if not raw:
        raise ValueError(f"{source} has no findings data")
    payload = json.loads(raw)
    findings = payload.get("findings") if isinstance(payload, dict) else payload
    if not isinstance(findings, list):
        raise ValueError(f"{source} findings data is not a list")
    return findings


def finding_count_text(count: int) -> str:
    """Return a compact human-readable finding count."""
    if count == 0:
        return "no findings"
    return f"{count} finding{'s' if count != 1 else ''}"


def one_line_summary(value: object, limit: int = FINDING_SUMMARY_LIMIT) -> str:
    """Collapse recorded prose to one readable, bounded Markdown line."""
    summary = " ".join(str(value or "").split()) or "No summary recorded."
    if len(summary) <= limit:
        return summary
    return summary[: limit - 1].rstrip() + "…"


def review_findings_comment(pr_id: str) -> "tuple[str | None, str | None]":
    """Render the run's review record, or a reason it cannot be rendered.

    Read-only against ~/.no-mistakes/state.sqlite: the run is matched by the
    /pullrequest/<id> suffix of its recorded pr_url, so the tool needs no run
    id argument. Compaction drops the report's <details> bodies from the
    description; this preserves their substance where the char limit is ~150k
    and edits survive merge. Clean reviews still get a summary-only thread.
    """
    db_path = os.path.expanduser("~/.no-mistakes/state.sqlite")
    if not os.path.exists(db_path):
        return None, f"state database not found at {db_path}"
    try:
        with sqlite3.connect(f"file:{db_path}?mode=ro", uri=True) as db:
            row = db.execute(
                """SELECT res.id, res.run_id, res.findings_json,
                          COALESCE(runs.review_approved_head_sha,
                                   runs.submitted_head_sha, runs.head_sha)
                   FROM step_results res
                   JOIN runs ON runs.id = res.run_id
                   WHERE runs.pr_url LIKE '%/pullrequest/' || ?
                     AND res.step_name = 'review'
                   ORDER BY res.completed_at DESC LIMIT 1""",
                (pr_id,),
            ).fetchone()
            if not row:
                return None, f"no recorded review run found for PR {pr_id}"
            step_result_id, run_id, payload, fallback_head = row
            findings = parse_findings(payload, f"review result {step_result_id}")
            rounds = db.execute(
                """SELECT round, trigger_type, findings_json,
                          reviewed_head_sha, fix_summary
                   FROM step_rounds
                   WHERE step_result_id = ?
                   ORDER BY round""",
                (step_result_id,),
            ).fetchall()
    except (json.JSONDecodeError, sqlite3.Error, ValueError) as exc:
        return None, str(exc)

    reviewed_head = next(
        (round_row[3] for round_row in reversed(rounds) if round_row[3]),
        fallback_head,
    )

    lines = [
        COMMENT_HEADING,
        "",
        "### Review summary",
        "",
        f"- Run ID: `{run_id}`",
        f"- Reviewed head: `{reviewed_head or 'not recorded'}`",
        f"- Review rounds: {len(rounds)}",
    ]
    try:
        parsed_rounds = [
            (
                round_no,
                trigger,
                parse_findings(round_payload, f"review round {round_no}"),
                round_head,
                fix_summary,
            )
            for round_no, trigger, round_payload, round_head, fix_summary in rounds
        ]
        round_ids = []
        for round_no, _, round_findings, _, _ in parsed_rounds:
            ids = set()
            for finding in round_findings:
                if not isinstance(finding, dict):
                    return None, f"review round {round_no} contains a non-object finding"
                if finding.get("id") is not None and str(finding["id"]):
                    ids.add(str(finding["id"]))
            round_ids.append(ids)

        def fixed_round_index(index: int, finding: dict) -> "int | None":
            raw_id = finding.get("id")
            if raw_id is None or not str(raw_id):
                return None
            finding_id = str(raw_id)
            if finding_id in round_ids[-1]:
                return None
            last_seen = max(
                (later for later in range(index, len(parsed_rounds))
                 if finding_id in round_ids[later]),
                default=index,
            )
            return last_seen + 1

        attributed_rounds = set()
        for index, (_, _, round_findings, _, _) in enumerate(parsed_rounds):
            for finding in round_findings:
                target = fixed_round_index(index, finding)
                if target is not None and parsed_rounds[target][4]:
                    attributed_rounds.add(target)

        for index, (
            round_no, trigger, round_findings, round_head, fix_summary
        ) in enumerate(parsed_rounds):
            outcome = finding_count_text(len(round_findings))
            detail = (
                f"- Round {round_no}: trigger `{trigger}`; outcome: {outcome}; "
                f"reviewed head: `{round_head or 'not recorded'}`"
            )
            if fix_summary and index not in attributed_rounds:
                prior_had_findings = index > 0 and bool(parsed_rounds[index - 1][2])
                label = "fix attempted" if prior_had_findings else "fix"
                detail += f"; {label}: {one_line_summary(fix_summary)}"
            lines.append(detail)
            for finding in round_findings:
                finding_id = str(finding.get("id") or "unnamed-finding")
                severity = str(finding.get("severity") or "severity not recorded")
                narrative = (
                    f"  - `{finding_id}` ({severity}): "
                    f"{one_line_summary(finding.get('description'))}"
                )
                target = fixed_round_index(index, finding)
                if target is not None and parsed_rounds[target][4]:
                    narrative += (
                        f"; fixed in round {parsed_rounds[target][0]}: "
                        f"{one_line_summary(parsed_rounds[target][4])}"
                    )
                lines.append(narrative)
    except (json.JSONDecodeError, ValueError) as exc:
        return None, str(exc)

    lines.extend([
        (
            "- Verdict: **no residual findings.**"
            if not findings
            else f"- Verdict: **{finding_count_text(len(findings))} "
            f"remain{'s' if len(findings) == 1 else ''}.**"
        ),
        "",
    ])
    if not findings:
        return "\n".join(lines), None

    lines.extend([
        "The PR description keeps the attestation and a one-line-per-step "
        "summary (Azure DevOps truncates descriptions at 4000 characters), so "
        f"the review's recorded findings live here in full. Run `{run_id}`.",
        "",
    ])
    for f in findings:
        if not isinstance(f, dict):
            return None, f"review result {step_result_id} contains a non-object finding"
        where = f.get("file", "")
        line_no = f.get("line")
        loc = f"`{where}:{line_no}`" if where and line_no else f"`{where}`" if where else ""
        lines.append(f"### {f.get('id')} — {f.get('severity')} {loc}")
        lines.append("")
        lines.append(str(f.get("description", "")).strip())
        lines.append("")
    return "\n".join(lines), None


def findings_thread_exists(org: str, project: str, repo: str, pr_id: str) -> bool:
    """True when the findings comment thread is already on the PR (rerun guard)."""
    result = subprocess.run(
        ["az", "devops", "invoke", "--organization", org,
         "--area", "git", "--resource", "pullRequestThreads",
         "--route-parameters", f"project={project}", f"repositoryId={repo}",
         f"pullRequestId={pr_id}",
         "--api-version", "7.1", "--http-method", "GET"],
        capture_output=True, text=True, check=True,
    )
    threads = json.loads(result.stdout).get("value", [])
    return any(
        (comment.get("content") or "").startswith(COMMENT_HEADING)
        for thread in threads
        for comment in thread.get("comments", [])
    )


def post_thread(org: str, project: str, repo: str, pr_id: str, content: str) -> None:
    """Post content as a closed comment thread on the PR."""
    thread = {
        "comments": [{"parentCommentId": 0, "content": content, "commentType": 1}],
        "status": "closed",
    }
    with tempfile.NamedTemporaryFile(
        "w", suffix=".json", delete=False, encoding="utf-8"
    ) as fh:
        json.dump(thread, fh)
        body_path = fh.name
    try:
        subprocess.run(
            ["az", "devops", "invoke", "--organization", org,
             "--area", "git", "--resource", "pullRequestThreads",
             "--route-parameters", f"project={project}", f"repositoryId={repo}",
             f"pullRequestId={pr_id}",
             "--api-version", "7.1", "--http-method", "POST",
             "--in-file", body_path],
            check=True, stdout=subprocess.DEVNULL,
        )
    finally:
        os.unlink(body_path)


def verify_build_policy(org: str, pr_id: str) -> None:
    """Refuse unless every ADO Build policy evaluation is approved."""
    try:
        result = subprocess.run(
            ["az", "repos", "pr", "policy", "list", "--id", pr_id,
             "--organization", org, "-o", "json"],
            capture_output=True, text=True, check=True,
        )
        policies = json.loads(result.stdout)
    except (json.JSONDecodeError, subprocess.CalledProcessError) as exc:
        raise SystemExit(
            f"error: CI was not verified green because Build policy status could not "
            f"be read for PR {pr_id}; description not updated"
        ) from exc

    builds = []
    for policy in policies if isinstance(policies, list) else []:
        configuration = policy.get("configuration") or {}
        policy_type = configuration.get("type") or policy.get("type") or {}
        type_id = str(policy_type.get("id") or "").casefold()
        display_name = str(policy_type.get("displayName") or "").casefold()
        if type_id == BUILD_POLICY_TYPE_ID or display_name == "build":
            builds.append(policy)
    if not builds:
        raise SystemExit(
            f"error: CI was not verified green because no Build policy evaluation "
            f"was found for PR {pr_id}; description not updated"
        )

    statuses = [str(policy.get("status") or "unknown").casefold() for policy in builds]
    if any(status != "approved" for status in statuses):
        raise SystemExit(
            f"error: CI was not verified green for PR {pr_id}; Build policy status: "
            f"{', '.join(statuses)}; description not updated"
        )


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--stdin":
        body = compact(sys.stdin.read())
        if body is not None:
            sys.stdout.write(body)
        return 0

    if len(sys.argv) != 3:
        print(__doc__, file=sys.stderr)
        return 2

    org, pr_id = sys.argv[1], sys.argv[2]
    try:
        show = subprocess.run(
            ["az", "repos", "pr", "show", "--id", pr_id, "--organization", org,
             "--query", "{description: description, repo: repository.name, "
             "project: repository.project.name, status: status}",
             "-o", "json"],
            capture_output=True, text=True, check=True,
        )
        pr = json.loads(show.stdout)
    except (json.JSONDecodeError, subprocess.CalledProcessError) as exc:
        print(
            f"error: PR {pr_id} could not be verified as existing; "
            "description not updated",
            file=sys.stderr,
        )
        return 1

    # Always give the review findings one predictable home: a closed comment
    # thread, posted on every gated PR whether or not the description fits.
    # Posting precedes any description rewrite so nothing is lost if the
    # update fails; a rerun is a no-op once the thread exists.
    comment, comment_error = review_findings_comment(pr_id)
    if comment is None:
        print(f"PR {pr_id}: review comment could not be built: {comment_error}")
    elif findings_thread_exists(org, pr["project"], pr["repo"], pr_id):
        print(f"PR {pr_id}: findings comment already posted")
    else:
        post_thread(org, pr["project"], pr["repo"], pr_id, comment)
        print(f"PR {pr_id}: review summary posted as a closed comment thread")

    status = (pr.get("status") or "").lower()
    if status != "active":
        if status in ("completed", "abandoned"):
            print(f"PR {pr_id}: status {status}; description left as-merged")
        else:
            print(
                f"PR {pr_id}: status {status or 'unknown'}; "
                "description left unchanged because only active PRs are rewritten"
            )
        return 0

    verify_build_policy(org, pr_id)
    body = compact(pr.get("description") or "", {"pr", "ci"})
    if body is None:
        print(f"PR {pr_id}: description already normalized, not rewritten")
        return 0

    subprocess.run(
        ["az", "repos", "pr", "update", "--id", pr_id, "--organization", org,
         "--description", body, "--query", "pullRequestId", "-o", "tsv"],
        check=True, stdout=subprocess.DEVNULL,
    )
    print(f"PR {pr_id}: description normalized to {len(body)} chars")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
