#!/usr/bin/env python3
"""Compact a no-mistakes PR description so the full report fits ADO's 4000-char cap.

Azure DevOps hard-truncates PR descriptions at 4000 characters. A no-mistakes
run whose review carried substantive findings embeds their full texts in the
report's <details> blocks, which can push the assembled body past the cap and
chop it mid-sentence (observed on Mosaiq PR 54362, 2026-09-02: 4023 chars, tail
cut inside a finding). ADO refuses description edits once a PR completes, so
the only window to fix the archive is between checks-passed and merge.

This tool keeps everything up to and including the attestation comment
byte-for-byte (Intent / What Changed / Risk / Pipeline header / attestation —
the RequireNoMistakes gate binds on the attestation, which must never be
altered), and replaces the <details> step blocks with one summary line per
step. Steps whose block was already truncated away are reconstructed from the
attestation's step list. On EVERY gated PR — whether or not the description
fits — a closed review comment records the run and round summary. Any residual
findings follow in full (read-only lookup in ~/.no-mistakes/state.sqlite by the
PR's /pullrequest/<id> url suffix), so reviewers always find them in the same
place: comments allow ~150k characters and survive merge. A rerun is a no-op
once the thread exists.

Usage:
  fm-pr-report-compact <org-url> <pr-id>            # compact in place via az
  fm-pr-report-compact --stdin < body > compacted   # pure filter, for tests

Always posts the review comment (skipping only when no local run data or an
existing thread is found); leaves a fitting description untouched. Run it only
after the pipeline reports checks-passed (custody has returned); never during
a run.
"""
import json
import os
import re
import sqlite3
import subprocess
import sys
import tempfile

CAP = 4000
TARGET = 3900
TRUNCATION_MARK = "(description truncated)"
COMMENT_HEADING = "## no-mistakes review — recorded findings (full texts)"


def compact(src: str) -> "str | None":
    """Return the compacted body, or None when src already fits untruncated."""
    if len(src) <= CAP and TRUNCATION_MARK not in src:
        return None

    attestation_end = src.index("-->") + len("-->")
    head = src[:attestation_end]

    summaries = re.findall(r"<summary>(.*?)</summary>", src[attestation_end:])
    lines = [re.sub(r"\*\*(.*?)\*\*", r"\1", s).strip() for s in summaries]

    att = re.search(r'"steps":(\[.*?\])', head)
    steps = json.loads(att.group(1)) if att else []
    covered = " ".join(lines).lower()
    for step in steps:
        if step["step"].lower() not in covered:
            lines.append(f"✅ {step['step']} - passed")

    body = head + "\n\n" + "\n".join(f"- {line}" for line in lines) + "\n"
    if len(body) > TARGET:
        raise SystemExit(f"error: still {len(body)} chars after compaction")
    return body


def parse_findings(raw: str, source: str) -> list:
    """Return the findings list from one recorded review payload."""
    if not raw:
        raise ValueError(f"{source} has no findings data")
    payload = json.loads(raw)
    findings = payload.get("findings") if isinstance(payload, dict) else payload
    if not isinstance(findings, list):
        raise ValueError(f"{source} findings data is not a list")
    return findings


def finding_count_text(count: int) -> str:
    """Return a compact human-readable finding count."""
    if count == 0:
        return "no findings"
    return f"{count} finding{'s' if count != 1 else ''}"


def review_findings_comment(pr_id: str) -> "tuple[str | None, str | None]":
    """Render the run's review record, or a reason it cannot be rendered.

    Read-only against ~/.no-mistakes/state.sqlite: the run is matched by the
    /pullrequest/<id> suffix of its recorded pr_url, so the tool needs no run
    id argument. Compaction drops the report's <details> bodies from the
    description; this preserves their substance where the char limit is ~150k
    and edits survive merge. Clean reviews still get a summary-only thread.
    """
    db_path = os.path.expanduser("~/.no-mistakes/state.sqlite")
    if not os.path.exists(db_path):
        return None, f"state database not found at {db_path}"
    try:
        with sqlite3.connect(f"file:{db_path}?mode=ro", uri=True) as db:
            row = db.execute(
                """SELECT res.id, res.run_id, res.findings_json,
                          COALESCE(runs.review_approved_head_sha,
                                   runs.submitted_head_sha, runs.head_sha)
                   FROM step_results res
                   JOIN runs ON runs.id = res.run_id
                   WHERE runs.pr_url LIKE '%/pullrequest/' || ?
                     AND res.step_name = 'review'
                   ORDER BY res.completed_at DESC LIMIT 1""",
                (pr_id,),
            ).fetchone()
            if not row:
                return None, f"no recorded review run found for PR {pr_id}"
            step_result_id, run_id, payload, fallback_head = row
            findings = parse_findings(payload, f"review result {step_result_id}")
            rounds = db.execute(
                """SELECT round, trigger_type, findings_json,
                          reviewed_head_sha, fix_summary
                   FROM step_rounds
                   WHERE step_result_id = ?
                   ORDER BY round""",
                (step_result_id,),
            ).fetchall()
    except (json.JSONDecodeError, sqlite3.Error, ValueError) as exc:
        return None, str(exc)

    reviewed_head = next(
        (round_row[3] for round_row in reversed(rounds) if round_row[3]),
        fallback_head,
    )

    lines = [
        COMMENT_HEADING,
        "",
        "### Review summary",
        "",
        f"- Run ID: `{run_id}`",
        f"- Reviewed head: `{reviewed_head or 'not recorded'}`",
        f"- Review rounds: {len(rounds)}",
    ]
    try:
        for round_no, trigger, round_payload, round_head, fix_summary in rounds:
            outcome = finding_count_text(
                len(parse_findings(round_payload, f"review round {round_no}"))
            )
            detail = (
                f"- Round {round_no}: trigger `{trigger}`; outcome: {outcome}; "
                f"reviewed head: `{round_head or 'not recorded'}`"
            )
            if fix_summary:
                detail += f"; fix summary: {' '.join(fix_summary.split())}"
            lines.append(detail)
    except (json.JSONDecodeError, ValueError) as exc:
        return None, str(exc)

    lines.extend([
        (
            "- Verdict: **no residual findings.**"
            if not findings
            else f"- Verdict: **{finding_count_text(len(findings))} "
            f"remain{'s' if len(findings) == 1 else ''}.**"
        ),
        "",
    ])
    if not findings:
        return "\n".join(lines), None

    lines.extend([
        "The PR description keeps the attestation and a one-line-per-step "
        "summary (Azure DevOps truncates descriptions at 4000 characters), so "
        f"the review's recorded findings live here in full. Run `{run_id}`.",
        "",
    ])
    for f in findings:
        if not isinstance(f, dict):
            return None, f"review result {step_result_id} contains a non-object finding"
        where = f.get("file", "")
        line_no = f.get("line")
        loc = f"`{where}:{line_no}`" if where and line_no else f"`{where}`" if where else ""
        lines.append(f"### {f.get('id')} — {f.get('severity')} {loc}")
        lines.append("")
        lines.append(str(f.get("description", "")).strip())
        lines.append("")
    return "\n".join(lines), None


def findings_thread_exists(org: str, project: str, repo: str, pr_id: str) -> bool:
    """True when the findings comment thread is already on the PR (rerun guard)."""
    result = subprocess.run(
        ["az", "devops", "invoke", "--organization", org,
         "--area", "git", "--resource", "pullRequestThreads",
         "--route-parameters", f"project={project}", f"repositoryId={repo}",
         f"pullRequestId={pr_id}",
         "--api-version", "7.1", "--http-method", "GET"],
        capture_output=True, text=True, check=True,
    )
    threads = json.loads(result.stdout).get("value", [])
    return any(
        (comment.get("content") or "").startswith(COMMENT_HEADING)
        for thread in threads
        for comment in thread.get("comments", [])
    )


def post_thread(org: str, project: str, repo: str, pr_id: str, content: str) -> None:
    """Post content as a closed comment thread on the PR."""
    thread = {
        "comments": [{"parentCommentId": 0, "content": content, "commentType": 1}],
        "status": "closed",
    }
    with tempfile.NamedTemporaryFile(
        "w", suffix=".json", delete=False, encoding="utf-8"
    ) as fh:
        json.dump(thread, fh)
        body_path = fh.name
    try:
        subprocess.run(
            ["az", "devops", "invoke", "--organization", org,
             "--area", "git", "--resource", "pullRequestThreads",
             "--route-parameters", f"project={project}", f"repositoryId={repo}",
             f"pullRequestId={pr_id}",
             "--api-version", "7.1", "--http-method", "POST",
             "--in-file", body_path],
            check=True, stdout=subprocess.DEVNULL,
        )
    finally:
        os.unlink(body_path)


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--stdin":
        body = compact(sys.stdin.read())
        if body is not None:
            sys.stdout.write(body)
        return 0

    if len(sys.argv) != 3:
        print(__doc__, file=sys.stderr)
        return 2

    org, pr_id = sys.argv[1], sys.argv[2]
    show = subprocess.run(
        ["az", "repos", "pr", "show", "--id", pr_id, "--organization", org,
         "--query", "{description: description, repo: repository.name, "
         "project: repository.project.name, status: status}",
         "-o", "json"],
        capture_output=True, text=True, check=True,
    )
    pr = json.loads(show.stdout)

    # Always give the review findings one predictable home: a closed comment
    # thread, posted on every gated PR whether or not the description fits.
    # Posting precedes any description rewrite so nothing is lost if the
    # update fails; a rerun is a no-op once the thread exists.
    comment, comment_error = review_findings_comment(pr_id)
    if comment is None:
        print(f"PR {pr_id}: review comment could not be built: {comment_error}")
    elif findings_thread_exists(org, pr["project"], pr["repo"], pr_id):
        print(f"PR {pr_id}: findings comment already posted")
    else:
        post_thread(org, pr["project"], pr["repo"], pr_id, comment)
        print(f"PR {pr_id}: review summary posted as a closed comment thread")

    status = (pr.get("status") or "").lower()
    if status != "active":
        if status in ("completed", "abandoned"):
            print(f"PR {pr_id}: status {status}; description left as-merged")
        else:
            print(
                f"PR {pr_id}: status {status or 'unknown'}; "
                "description left unchanged because only active PRs are rewritten"
            )
        return 0

    body = compact((pr.get("description") or "").rstrip("\n"))
    if body is None:
        print(f"PR {pr_id}: description fits, not rewritten")
        return 0

    subprocess.run(
        ["az", "repos", "pr", "update", "--id", pr_id, "--organization", org,
         "--description", body, "--query", "pullRequestId", "-o", "tsv"],
        check=True, stdout=subprocess.DEVNULL,
    )
    print(f"PR {pr_id}: report compacted to {len(body)} chars")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
